{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fencingtoken-live",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://fencingtoken.com,https://www.fencingtoken.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "ARCADE",
        "class_name": "Arcade"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Arcade"
      ]
    }
  ]
}